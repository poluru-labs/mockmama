    },
    {
      "path": "agents.json",
      "entity": "AiAgent[] (MOCK_AGENTS)"
    },
    {
      "path": "dashboard-metrics.json",
      "entity": "dashboard hero metrics"
    },
    {
      "path": "projects.json",
      "entity": "client design projects"
    },
    {
      "path": "design-briefs.json",
