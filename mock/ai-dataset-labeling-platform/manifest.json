{
  "version": "1.1.0",
  "description": "Fixture JSON for AI Dataset Labeling Platform — mirrors agents, dashboard metrics, mock chat behavior, and labeling entities (projects, schema, annotations, consensus, QA, export, batches, queue).",
  "files": [
    { "path": "app.json", "entity": "application metadata" },
    { "path": "workspace.json", "entity": "workspace / tenant" },
    { "path": "users.json", "entity": "annotators and reviewers" },
    { "path": "navigation.json", "entity": "primary nav" },
    { "path": "settings.json", "entity": "workspace settings" },
    { "path": "agents.json", "entity": "AiAgent[] (MOCK_AGENTS)" },
    { "path": "dashboard-metrics.json", "entity": "dashboard hero metrics" },
    { "path": "dashboard-overview.json", "entity": "progress by project" },
    { "path": "annotator-metrics.json", "entity": "per-annotator agreement stats" },
    { "path": "labeling-projects.json", "entity": "labeling projects and progress" },
    { "path": "label-schema.json", "entity": "intent taxonomy and export formats" },
    { "path": "label-schema-pii.json", "entity": "PII span taxonomy" },
    { "path": "guidelines.json", "entity": "annotator guideline docs" },
    { "path": "few-shot-examples.json", "entity": "prompt few-shot library" },
    { "path": "labeling-items.json", "entity": "sample items in queue" },
    { "path": "labeling-queue.json", "entity": "assignee queue rows" },
    { "path": "annotations.json", "entity": "raw annotator submissions" },
    { "path": "suggestions.json", "entity": "assistive proposals (Label Suggester)" },
    { "path": "consensus.json", "entity": "vote merge decisions" },
    { "path": "qa-batches.json", "entity": "audit samples and drift (QA Sampler)" },
    { "path": "export-manifests.json", "entity": "JSONL/COCO exports" },
    { "path": "batches.json", "entity": "labeling waves (Batch Orchestrator)" },
    { "path": "comments.json", "entity": "item thread comments" },
    { "path": "activity.json", "entity": "audit activity feed" },
    { "path": "notifications.json", "entity": "in-app notifications" },
    { "path": "chat-sessions.json", "entity": "ChatSession samples" },
    { "path": "chat-completions.json", "entity": "ChatCompletionRequest/Response per agent category" }
  ]
}