{
  "version": "1.1.0",
  "description": "Fixture JSON for AI Email Assistant — mirrors agents, dashboard metrics, mock chat behavior, and inbox entities (threads, triage, drafts, follow-ups, templates, scheduling).",
  "files": [
    { "path": "app.json", "entity": "application metadata" },
    { "path": "workspace.json", "entity": "workspace / tenant" },
    { "path": "users.json", "entity": "mailbox owners and shared inboxes" },
    { "path": "navigation.json", "entity": "primary nav" },
    { "path": "settings.json", "entity": "workspace settings" },
    { "path": "agents.json", "entity": "AiAgent[] (MOCK_AGENTS)" },
    { "path": "dashboard-metrics.json", "entity": "dashboard hero metrics" },
    { "path": "dashboard-overview.json", "entity": "inbox and draft summary" },
    { "path": "voice-profiles.json", "entity": "tone and signature rules" },
    { "path": "labels.json", "entity": "triage label taxonomy" },
    { "path": "routing-queues.json", "entity": "triage destination queues" },
    { "path": "contacts.json", "entity": "frequent correspondents" },
    { "path": "threads.json", "entity": "email threads and messages" },
    { "path": "thread-summaries.json", "entity": "decisions and owners (Thread Summarizer)" },
    { "path": "inbox-messages.json", "entity": "inbound queue items" },
    { "path": "attachments.json", "entity": "message attachments metadata" },
    { "path": "triage-results.json", "entity": "priority and labels (Inbox Triage)" },
    { "path": "drafts.json", "entity": "tone-matched drafts (Tone Drafter)" },
    { "path": "scheduled-sends.json", "entity": "scheduled and cancelled sends" },
    { "path": "follow-ups.json", "entity": "nudges and reminders (Follow-up Coach)" },
    { "path": "templates.json", "entity": "snippets and matches (Template Librarian)" },
    { "path": "activity.json", "entity": "audit activity feed" },
    { "path": "notifications.json", "entity": "in-app notifications" },
    { "path": "chat-sessions.json", "entity": "ChatSession samples" },
    { "path": "chat-completions.json", "entity": "ChatCompletionRequest/Response per agent category" }
  ]
}