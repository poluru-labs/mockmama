{
  "version": "1.1.0",
  "description": "Fixture JSON for AI Customer Support Console — mirrors agents, dashboard metrics, mock chat behavior, and support domain entities (tickets, KB, macros, sentiment, escalation, triage, incidents, SLA).",
  "files": [
    { "path": "app.json", "entity": "application metadata" },
    { "path": "workspace.json", "entity": "workspace / tenant" },
    { "path": "users.json", "entity": "human support agents" },
    { "path": "navigation.json", "entity": "primary nav" },
    { "path": "settings.json", "entity": "workspace settings" },
    { "path": "queues.json", "entity": "routing queues" },
    { "path": "product-areas.json", "entity": "triage product areas" },
    { "path": "agents.json", "entity": "AiAgent[] (MOCK_AGENTS)" },
    { "path": "dashboard-metrics.json", "entity": "dashboard hero metrics" },
    { "path": "dashboard-overview.json", "entity": "volume and channel summary" },
    { "path": "customers.json", "entity": "customer profiles and tiers" },
    { "path": "tickets.json", "entity": "inbound support tickets" },
    { "path": "ticket-messages.json", "entity": "ticket conversation threads" },
    { "path": "inbox.json", "entity": "inbox views and counts" },
    { "path": "kb-articles.json", "entity": "KB articles and grounded reply drafts" },
    { "path": "macros.json", "entity": "macros and merge-field suggestions" },
    { "path": "sentiment-analysis.json", "entity": "tone scores and coaching hints" },
    { "path": "sla-policies.json", "entity": "tier SLA targets" },
    { "path": "sla-snapshots.json", "entity": "per-ticket SLA state" },
    { "path": "escalations.json", "entity": "playbooks and handoff recommendations" },
    { "path": "incidents.json", "entity": "active and resolved incidents" },
    { "path": "triage-results.json", "entity": "queue classification (Queue Triage)" },
    { "path": "csat-surveys.json", "entity": "customer satisfaction responses" },
    { "path": "activity.json", "entity": "audit activity feed" },
    { "path": "notifications.json", "entity": "in-app notifications" },
    { "path": "chat-sessions.json", "entity": "ChatSession samples" },
    { "path": "chat-completions.json", "entity": "ChatCompletionRequest/Response per agent category" }
  ]
}