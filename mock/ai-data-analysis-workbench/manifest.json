{
  "version": "1.1.0",
  "description": "Fixture JSON for AI Data Analysis Workbench — mirrors agents, dashboard metrics, mock chat behavior, and analysis entities (datasets, schema, queries, charts, insights, notebooks, quality, exports).",
  "files": [
    { "path": "app.json", "entity": "application metadata" },
    { "path": "workspace.json", "entity": "workspace / tenant" },
    { "path": "users.json", "entity": "analyst users" },
    { "path": "navigation.json", "entity": "primary nav" },
    { "path": "settings.json", "entity": "workspace settings" },
    { "path": "agents.json", "entity": "AiAgent[] (MOCK_AGENTS)" },
    { "path": "dashboard-metrics.json", "entity": "dashboard hero metrics" },
    { "path": "dashboard-overview.json", "entity": "runs and dataset health" },
    { "path": "datasets.json", "entity": "connected data sources" },
    { "path": "schema-catalog.json", "entity": "shop analytics schema" },
    { "path": "schema-catalog-marketing.json", "entity": "marketing export schema" },
    { "path": "schema-catalog-support.json", "entity": "support mirror schema" },
    { "path": "data-quality-alerts.json", "entity": "quality and freshness alerts" },
    { "path": "queries.json", "entity": "NL → SQL drafts (Query Translator)" },
    { "path": "sample-results.json", "entity": "tabular result previews" },
    { "path": "chart-recommendations.json", "entity": "viz encoding suggestions" },
    { "path": "insights.json", "entity": "narratives and caveats (Insight Narrator)" },
    { "path": "notebooks.json", "entity": "reproducible cells (Notebook Scribe)" },
    { "path": "analysis-runs.json", "entity": "linked query → chart → insight runs" },
    { "path": "saved-views.json", "entity": "filtered insight and query views" },
    { "path": "schedules.json", "entity": "scheduled query runs" },
    { "path": "export-jobs.json", "entity": "notebook and insight exports" },
    { "path": "comments.json", "entity": "thread comments on queries and insights" },
    { "path": "activity.json", "entity": "audit activity feed" },
    { "path": "notifications.json", "entity": "in-app notifications" },
    { "path": "chat-sessions.json", "entity": "ChatSession samples" },
    { "path": "chat-completions.json", "entity": "ChatCompletionRequest/Response per agent category" }
  ]
}